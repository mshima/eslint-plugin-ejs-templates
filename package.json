{
  "name": "eslint-plugin-ejs-templates-monorepo",
  "private": true,
  "description": "eslint-plugin-ejs-templates and the packages it is built on",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mshima/eslint-plugin-ejs-templates.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/eslint-plugin-ejs-templates"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "fix": "prettier . --write && eslint . --fix",
    "lint": "eslint .",
    "prepare": "husky && npm run build",
    "pretest": "prettier . --check && eslint .",
    "test": "vitest run",
    "posttest": "npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/debug": "^4.1.13",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
